{
  "name": "krometra-web",
  "private": true,
  "version": "0.1.0",
  "license": "SEE LICENSE IN ../LICENSE.md",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:size && vue-tsc --noEmit && vite build",
    "check:size": "eslint src/",
    "preview": "vite preview",
    "lint": "eslint src/ --max-warnings 0",
    "gen:api": "node scripts/gen-api-types.mjs",
    "gen:api:check": "node scripts/gen-api-types.mjs --check",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium",
    "test": "vitest run",
    "bench": "vitest bench --run",
    "bench:smoke": "vitest bench --run --mode smoke --fileParallelism",
    "bench:save": "vitest bench --run --outputJson bench-results/baseline.json",
    "bench:compare": "vitest bench --run --compare bench-results/baseline.json",
    "mcp": "node mcp/server.mjs",
    "test:mcp": "node --test \"mcp/test/*.test.mjs\""
  },
  "dependencies": {
    "@types/three": "^0.170.0",
    "@vueuse/core": "^11.0.0",
    "@zag-js/collapsible": "^0.77.1",
    "@zag-js/combobox": "^0.77.1",
    "@zag-js/dialog": "^0.77.0",
    "@zag-js/menu": "^0.77.1",
    "@zag-js/number-input": "^0.77.1",
    "@zag-js/select": "^0.77.1",
    "@zag-js/splitter": "^0.77.1",
    "@zag-js/tabs": "^0.77.1",
    "@zag-js/toast": "^0.77.0",
    "@zag-js/tooltip": "^0.77.1",
    "@zag-js/tree-view": "^0.77.1",
    "@zag-js/vue": "^0.77.0",
    "foxy-ui-kit": "^0.2.0",
    "replicad": "1.1.0",
    "replicad-opencascadejs": "1.1.0",
    "three": "^0.170.0",
    "vue": "^3.5.0",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-vue": "^5.1.0",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "^9.0.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.9",
    "vue-tsc": "^2.0.0"
  }
}
