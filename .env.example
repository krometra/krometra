# Database
DATABASE_URL=postgresql+asyncpg://cadstudio:cadstudio@localhost:5432/cadstudio

# Redis
REDIS_URL=redis://localhost:6379/0

# MinIO / S3
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=cad-studio
MINIO_SECURE=false

# JWT
JWT_SECRET=change-me-in-production-use-a-strong-random-secret-at-least-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Refresh Token
REFRESH_TOKEN_BYTES=32
REFRESH_TOKEN_EXPIRE_DAYS=30

# Администраторы: почты через запятую получают роль при входе, refresh и /api/auth/me
# (только повышение). Явно: python -m app.cli admin grant|revoke <email>
ADMIN_EMAILS=

# CORS
CORS_ORIGINS=http://localhost:5173

# App
DEBUG=true
APP_NAME=Крометра
APP_VERSION=0.1.0

# Язык интерфейса по умолчанию: ru, en или zh. Подставляется при сборке фронтенда
# (make rebuild-front); выбор пользователя в браузере важнее. Для vite dev
# переменную читает сам Vite: web/.env.local или окружение процесса.
VITE_DEFAULT_LOCALE=ru

# Оператор персональных данных для страниц /privacy и /consent: ФИО (или название)
# и почта для обращений. Подставляются при сборке фронтенда, в прод-сборке обязательны.
VITE_OPERATOR_NAME=
VITE_OPERATOR_EMAIL=

# Публичный адрес сайта: из него удалённый MCP-сервер (сервис mcp) строит
# ссылки на редактор и на скачивание экспорта.
PUBLIC_URL=http://localhost

# Почта: письма подтверждения адреса и восстановления пароля уходят через SMTP
# почты для домена (Яндекс 360, VK WorkSpace и т.п.), ссылки в них строятся от PUBLIC_URL.
# SMTP_SECURITY: ssl (порт 465), starttls (порт 587) или none. Пустой SMTP_HOST:
# письма не отправляются, а пишутся в лог. Dev-compose (docker-compose.yml) эти
# значения не читает и всегда шлёт письма в Mailpit: http://localhost:8025.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Крометра <noreply@krometra.ru>

# Публикуемые порты (переопредели, если заняты другим проектом)
# WEB_PORT=80
# APP_PORT=8000
# MINIO_PORT=9000
# MCP_PORT=8787
# MAILPIT_WEB_PORT=8025
# MAILPIT_SMTP_PORT=1025
