# Database
DATABASE_URL=postgresql+asyncpg://cadstudio:cadstudio@localhost:5432/cadstudio

# Redis
REDIS_URL=redis://localhost:6379/0

# MinIO / S3
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=cad-studio
MINIO_SECURE=false

# JWT
JWT_SECRET=change-me-in-production-use-a-strong-random-secret-at-least-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Refresh Token
REFRESH_TOKEN_BYTES=32
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS
CORS_ORIGINS=http://localhost:5173

# App
DEBUG=true
APP_NAME=Крометра
APP_VERSION=0.1.0

# Язык интерфейса по умолчанию: ru, en или zh. Подставляется при сборке фронтенда
# (make rebuild-front); выбор пользователя в браузере важнее. Для vite dev
# переменную читает сам Vite: web/.env.local или окружение процесса.
VITE_DEFAULT_LOCALE=ru

# Публичный адрес сайта: из него удалённый MCP-сервер (сервис mcp) строит
# ссылки на редактор и на скачивание экспорта.
PUBLIC_URL=http://localhost

# Публикуемые порты (переопредели, если заняты другим проектом)
# WEB_PORT=80
# APP_PORT=8000
# MINIO_PORT=9000
# MCP_PORT=8787
